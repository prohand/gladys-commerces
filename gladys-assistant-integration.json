      "required": false,
      "default": "E.Leclerc"
    },
    {
      "key": "opening_hours",
      "type": "string",
      "label": {
        "en": "Opening hours",
        "fr": "Horaires d'ouverture",
        "de": "Öffnungszeiten",
        "es": "Horario de apertura"
      },
      "description": {
        "en": "OpenStreetMap syntax: days Mo Tu We Th Fr Sa Su, PH for public holidays, off when closed, rules separated by a semicolon.",
        "fr": "Syntaxe OpenStreetMap : jours Mo Tu We Th Fr Sa Su, PH pour les jours fériés, off si fermé, règles séparées par un point-virgule.",
        "de": "OpenStreetMap-Syntax: Tage Mo Tu We Th Fr Sa Su, PH für Feiertage, off wenn geschlossen, Regeln durch Semikolon getrennt.",
        "es": "Sintaxis OpenStreetMap: días Mo Tu We Th Fr Sa Su, PH para los festivos, off si está cerrado, reglas separadas por punto y coma."
      },
      "placeholder": {
        "en": "e.g. Mo-Sa 08:30-20:00; Su 09:00-12:30; PH off",
        "fr": "ex. Mo-Sa 08:30-20:00; Su 09:00-12:30; PH off",
        "de": "z. B. Mo-Sa 08:30-20:00; Su 09:00-12:30; PH off",
        "es": "p. ej. Mo-Sa 08:30-20:00; Su 09:00-12:30; PH off"
      },
      "required": true,
      "default": "Mo-Sa 08:30-20:00; PH off"
