{
  "manifest_version": 1,
  "type": "device",
  "name": "E.Leclerc",
  "description": {
    "en": "Product recalls that concern your E.Leclerc store, and its opening hours.",
    "fr": "Rappels de produits qui concernent votre magasin E.Leclerc, et ses horaires.",
    "de": "Produktrückrufe, die Ihren E.Leclerc-Markt betreffen, und seine Öffnungszeiten.",
    "es": "Avisos de retirada de productos de su tienda E.Leclerc, y su horario."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/prohand/gladys-eleclerc:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-eleclerc/main/cover.png",
  "categories": ["services", "notifications"],
  "keywords": [
    "leclerc",
    "e.leclerc",
    "rappel conso",
    "rappel produit",
    "product recall",
    "supermarché",
    "horaires",
    "opening hours",
    "code-barres",
    "magasin"
  ],
  "countries": ["FR"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "Two things, with no account: the product recalls of RappelConso, the official French register, filtered for E.Leclerc, and the opening hours of your store. Type the hours as on its map page, e.g. Mo-Sa 08:30-20:00; PH off.",
        "fr": "Deux choses, sans compte : les rappels de produits de RappelConso, le registre officiel français, filtrés pour E.Leclerc, et les horaires de votre magasin. Saisissez les horaires comme sur sa fiche de carte, ex. Mo-Sa 08:30-20:00; PH off.",
        "de": "Zwei Dinge, ohne Konto: die Produktrückrufe von RappelConso, dem offiziellen französischen Register, gefiltert für E.Leclerc, und die Öffnungszeiten Ihres Markts. Geben Sie die Zeiten wie auf seiner Kartenseite ein, z. B. Mo-Sa 08:30-20:00; PH off.",
        "es": "Dos cosas, sin cuenta: los avisos de retirada de RappelConso, el registro oficial francés, filtrados para E.Leclerc, y el horario de su tienda. Escriba el horario como en su ficha del mapa, p. ej. Mo-Sa 08:30-20:00; PH off."
      },
      "links": [
        {
          "url": "https://rappel.conso.gouv.fr/",
          "label": {
            "en": "RappelConso",
            "fr": "RappelConso",
            "de": "RappelConso",
            "es": "RappelConso"
          }
        },
        {
          "url": "https://wiki.openstreetmap.org/wiki/Key:opening_hours",
          "label": {
            "en": "Opening hours syntax",
            "fr": "Syntaxe des horaires",
            "de": "Syntax der Öffnungszeiten",
            "es": "Sintaxis del horario"
          }
        },
        {
          "url": "https://github.com/prohand/gladys-eleclerc/blob/main/docs/en.md",
          "label": {
            "en": "Documentation",
            "fr": "Documentation",
            "de": "Dokumentation",
            "es": "Documentación"
          }
        }
      ]
    },
    {
      "key": "store_section",
      "type": "section",
      "label": {
        "en": "Your store",
        "fr": "Votre magasin",
        "de": "Ihr Markt",
        "es": "Su tienda"
      }
    },
    {
      "key": "store_name",
      "type": "string",
      "label": {
        "en": "Store name",
        "fr": "Nom du magasin",
        "de": "Name des Markts",
        "es": "Nombre de la tienda"
      },
      "description": {
        "en": "The name of the store device in Gladys.",
        "fr": "Le nom de l'appareil magasin dans Gladys.",
        "de": "Der Name des Markt-Geräts in Gladys.",
        "es": "El nombre del dispositivo tienda en Gladys."
      },
      "placeholder": {
        "en": "e.g. E.Leclerc Carcassonne",
        "fr": "ex. E.Leclerc Carcassonne",
        "de": "z. B. E.Leclerc Carcassonne",
        "es": "p. ej. E.Leclerc Carcassonne"
